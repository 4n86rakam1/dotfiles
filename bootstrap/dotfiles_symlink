#!/bin/bash -eux

dotfiles_root_directory=$(git rev-parse --show-toplevel)

dotfiles_list=(
    .bashrc
    .profile
    .emacs.d/
    .gitconfig
    .gitignore_global
    .tmux.conf
    .tmux.conf.linux
    .tmux.conf.macos
    .vim/
    .bash_completion
    .bash_aliases
    .markdownlint.yaml
    .claude/settings.json
    .claude/statusline.py
    .claude/skills/memory-audit/
    .claude/skills/memory-sweep/
    .claude/skills/proofread-en/
    .claude/skills/proofread-ja/
    .claude/skills/spec/
    .config/proofread/
    .config/tabby/config.yaml
    .local/bin/proofread
    .claude/CLAUDE.md
    .claude/rules/
)

for dotfile in "${dotfiles_list[@]}"; do
    target="${HOME}/${dotfile%/}"

    # ln -sfn links inside a real directory instead of replacing it, and exits 0
    # doing so. Refuse rather than leave a nested link the caller never sees.
    if [[ -d "${target}" && ! -L "${target}" ]]; then
        echo "${target} is a real directory; remove it before linking" >&2
        exit 1
    fi

    mkdir -p "$(dirname "${target}")"
    ln -sfn "${dotfiles_root_directory}/${dotfile}" "${target}"
done

#!/bin/bash -eux

dotfiles_root_directory=$(git rev-parse --show-toplevel)

dotfiles_list=(
    .bashrc
    .profile
    .emacs.d/
    .gitconfig
    .gitignore_global
    .tmux.conf
    .tmux.conf.linux
    .tmux.conf.macos
    .vim/
    .bash_completion
    .bash_aliases
    .markdownlint.yaml
    .claude/settings.json
    .claude/statusline.py
    .claude/skills/memory-audit/
    .claude/skills/proofread-en/
    .claude/skills/proofread-ja/
    .config/proofread/
    .config/tabby/config.yaml
    .local/bin/proofread
    .claude/CLAUDE.md
    .claude/rules/code-review.md
    .claude/rules/code-style-general.md
    .claude/rules/code-style-md.md
    .claude/rules/code-style-sh.md
    .claude/rules/formatter.md
    .claude/rules/pr-creation.md
    .claude/rules/response-format.md
    .claude/rules/response-link.md
    .claude/rules/response-style-ja.md
    .claude/rules/review-hygiene.md
    .claude/rules/skill-creation.md
    .claude/rules/worktree-exit.md
)

for dotfile in "${dotfiles_list[@]}"; do
    mkdir -p "$(dirname "${HOME}/${dotfile%/}")"
    ln -sfn "${dotfiles_root_directory}/${dotfile}" "${HOME}/${dotfile%/}"
done
